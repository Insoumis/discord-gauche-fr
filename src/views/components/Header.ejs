<header>
    <nav class="<%= typeof bg == 'undefined' ? '' : 'simplified' %>">
        <a id="header-logo" href="<%= typeof simplified=='undefined' ? '#top' : '/' %>" class="header-button btn-padding-adapt"
            style="display: <%= typeof simplified == 'undefined' ? 'none' : 'flex' %>" aria-label="Qui sommes-nous ?">
            <img src="/assets/LOGO I BARRICADE BLANC.svg" alt="Le logo de la Barricade" style="width: 2rem;" /><span>La
                Barricade</span>
        </a>
        <% if (typeof simplified=='undefined' ) { %>
            <label for="search-bar" id="search-bar-label">
                <img src="/assets/icons/mag.svg" width="30px">
            </label>
            <input id="search-bar" oninput="return searchTyping(this.value)"
                aria-label="Taper un mot-clé pour filtrer les résultats" />
            <img id="search-cross" src="/assets/icons/xmark.svg" class="icon-img" onclick="return resetSearch()" />

            <a class="header-button" style="display: <%= typeof simplified == 'undefined' ? 'flex' : 'none' %>"
                aria-label="Plein écran" onclick="return onClickFullScreen()">
                <img src="/assets/icons/expand.svg" width="30px;" />
            </a>
            <% } %>
    </nav>
</header>

<style>
    header {
        top: 0;
        color: var(--color-blanc);
        height: 4rem;
        display: flex;
        position: absolute;
        width: 100%;
        z-index: 1;
    }

    nav {
        padding-inline: 20px;
        display: flex;
        flex: 1;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        box-sizing: border-box;
    }

    nav.simplified {
        background-color: var(--color-rouge);
        box-shadow: 0 0.2rem 0.2rem var(--color-noir);
    }


    #search-bar-label {
        width: 2.5rem;
        height: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        filter: invert(100%);
        transition: filter 500ms, background-color 500ms;
        border-radius: 100px;
    }

    #search-bar-label:hover {
        filter: invert(0);
        background-color: var(--color-blanc);
    }

    #search-bar {
        height: 2rem;
        font-family: Grotesk;
        padding: 0;
        border: none;
        flex: 1;
        max-width: 0;
        display: flex;
        align-items: center;
        appearance: none;
        color: var(--color-noir);
        outline: none;
        background-color: transparent;
        transition: background-color 500ms, max-width 500ms, backround-color 500ms, margin-right 500ms;
    }


    #search-bar:focus,
    #search-bar.has-content {
        padding: 2px;
        max-width: 100%;
        outline: none;
        appearance: none;
        background-color: var(--color-blanc);
    }

    #search-cross {
        filter: invert(0);
        margin-left: -3rem;
        width: 3rem;
        display: none;
        cursor: pointer;
    }

    #search-cross.has-content {
        display: flex;
    }


    .header-button {
        height: 2.5rem;
        min-width: 2.5rem;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border-radius: 100px;
        outline: none;
        transition: filter 500ms, background-color 500ms;
        gap: 0.5rem;
        font-family: Mohave;
        font-weight: bold;
        text-transform: uppercase;
        color: white;
        text-decoration: none;
        font-size: large;
        filter: invert(100%);
    }

    .btn-padding-adapt {
        @media (width >=40rem) {
            padding-left: 5px;
        }
    }

    #header-logo {
        filter: invert(100);
        background-color: black;
        color: white;
        margin-right: auto;
    }

    .header-button>span {
        padding-right: 0.5rem;
    }

    .header-button:hover {
        filter: invert(0);
        background-color: var(--color-blanc);
    }

    #header-logo:hover {
        filter: invert(0);
    }

    .header-button:focus {
        filter: invert(0);
        background-color: var(--color-blanc);
    }

    #header-logo:focus {
        filter: invert(100);
        background-color: black;
    }

    .header-button>span {
        display: none;

        @media (width >=40rem) {
            display: block;
        }
    }
</style>