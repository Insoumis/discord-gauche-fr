<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('components/head', {title: `${post.title}` , image: `/covers/${post.id}.png`,
        card: "summary_large_image" , description: `${post.description}` }); %>
        <style>
            body {
                margin: 0;
                position: absolute;
                inset: 0;
                display: flex;
                flex-direction: column;
                background-color: var(--color-noir);
                color: var(--color-blanc);
                font-family: Grotesk;
                z-index: 1;
            }

            #banner {
                position: absolute;
                width: 100%;
                left: 0;
                right: 0;
                top: 0;
                height: 200px;
                background-position: center;
                background-size: cover;
                z-index: 0;

                @media (width >=40rem) {
                    height: 300px;
                }
            }

            #header {
                margin-top: 170px;
                margin-left: 20px;
                right: 0px;
                display: flex;
                flex-direction: row;
                z-index: 1;

                @media (width >=40rem) {
                    margin-top: 60px;
                }
            }

            #cover {
                min-width: 120px;
                min-height: 180px;
                background-position: center;
                background-size: cover;
                border-style: solid;

                @media (width >=40rem) {
                    min-width: 240px;
                    min-height: 360px;
                }
            }

            #header-infos {
                display: flex;
                flex-direction: column;
                justify-content: end;
                margin-left: 20px;
            }

            #header-infos>h1 {
                margin: 0;
                font-size: 2rem;
                font-family: Mohave;
                font-weight: bolder;
                text-transform: uppercase;
            }


            #header-infos>a {
                font-weight:bolder;
                font-family: Mohave;
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: center;
                background-color: var(--color-rouge);
                width: 5rem;
                padding: 0.2rem;
                border-radius: 100rem;
                gap: 0.2rem;
                font-size: 1.2rem;
                margin-bottom: 0.6rem;
            }

            #prod-content {
                flex: 1;
                padding: 20px;
            }

            #prod-description {
                padding: 20px;
                background-color: black;
                border: 1px solid var(--color-violet);
                display: flex;
                flex-direction: row;
                align-items: center;
                gap: 20px;
                font-size: large;
            }

            #prod-description>img {
                min-width: 20px;
            }

            #prod-links {
                display: flex;
                flex-direction: row;
                flex-wrap: wrap;
                margin-top: 20px;
                gap: 20px;
            }

            .prod-link {
                background-color: var(--color-rouge);
                color: var(--color-blanc);
            }

            .header-logo {
                position: absolute;
                top: 5px;
                left: 10px;
            }

            #prod-comments {
                margin-top: 50px;
                transform: matrix(0.95, 0.02, 0, 0.95, 1, 0);
                padding: 0.5rem;
                border: 1px solid var(--color-violet);
                background-color: #cd443a53;
            }


            .prod-comment-author {
                display: flex;
                flex-direction: row;
            }

            .prod-comment-author>img {
                width: 50px;
            }

            .prod-comment-name {
                display: flex;
                flex-direction: column;
                padding-left: 0.2rem;
            }

            .prod-comment {
                margin-top: 0.5rem;
                background-color: black;
                padding: 0.4rem;

                a {
                    color: var(--color-rouge);
                }

                img {
                    max-width: 100%;
                }
            }
        </style>
</head>

<body>
    <div id="banner" style="<%= `background-image: url( /banners/${post.id}.png );`%>"></div>

    <div id="header">
        <div id="cover" style="<%= `background-image: url( /covers/${post.id}.png );`%>"></div>
        <div id="header-infos">
            <% if (post.comments !==undefined) {%>
                <a class="btn" href="<%= post.comments.status.url %>" target="_blank"
                    aria-label="Ajouter un fav sur Mastodon">
                    <img src="/assets/icons/star.svg" class="icon-img" />
                    <%= post.comments.status.favourites_count %>
                </a>
                <% } %>
                    <h1 class="glow electric wiggle">
                        <%= post.title %>
                    </h1>
                    <%= post.year %>
        </div>
    </div>
    <div id="prod-content">
        <p id="prod-description">
            <img src="/assets/icons/info.svg" class="icon-img" />
            <%- post.description.replace("\n", "<br /><br />" ) %>
        </p>
        <div id="prod-links">
            <% post.access.forEach((btn)=> {%>
                <a class="prod-link btn" href="<%= btn.link %>" target="_blank" rel="noopener noreferrer"
                    aria-label="<%= btn.title %>">
                    <% if (['pointer', 'download' , 'play' , 'star' ].includes(btn.icon) ) { %>
                        <img src="/assets/icons/<%= btn.icon %>.svg" class="icon-img" />
                        <% } %>
                            <%= btn.title %>
                </a>
                <% });%>

        </div>
        <% if (post.comments !==undefined) {%>
            <div id="prod-comments">
                <a class="btn" aria-label="Voir les commentaires sur Mastodon" href="<%= post.comments.status.url %>"
                    target="_blank" style="display: flex; justify-content: flex-start; gap:0.2rem; padding: 0;">
                    <img src="/assets/masto.png" alt="Mastodon Logo" class="icon-img" /> <b>
                        Commentaires
                    </b>
                </a>
                <% for (comment of post.comments.list) { %>
                    <div class="prod-comment">
                        <div class="prod-comment-author">
                            <img src="<%= comment.avatar %>">
                            <div class="prod-comment-name">
                                <b>
                                    <%= comment.username %>
                                </b>
                                <i>
                                    <%= comment.acct %>
                                </i>
                            </div>
                        </div>
                        <div><%- comment.content %></div>
                        <% if (comment.media_attachments.length> 0 && comment.media_attachments[0].type ===
                            "image") {%>
                            <img aria-label="<%= comment.media_attachments[0].description %>"
                                src="<%= comment.media_attachments[0].preview_url %>">
                            <% } %>
                    </div>
                    <% } %>
                        <a aria-label="Ajouter un commentaire sur Mastodon" style="width: 200px; margin-top: 1vh;"
                            class="btn prod-link" href="<%= post.comments.status.url %>" target="_blank">
                            Ajouter un commentaire
                        </a>
            </div>
            <% } %>
    </div>
    <%- include('components/Header', {simplified: true}) %>
</body>

</html>